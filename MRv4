-- 创建透明度选项按钮
local function CreateTransparencyOptions()
    local yPosition = 0
    for optionName, transparencyValue in pairs(UISettings.TransparencyOptions) do
        local optionButton = Instance.new("TextButton")
        optionButton.Name = optionName .. "Option"
        optionButton.Size = UDim2.new(1, 0, 0, 18)
        optionButton.Position = UDim2.new(0, 0, 0, yPosition)
        optionButton.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
        optionButton.BackgroundTransparency = 0.3
        optionButton.BorderSizePixel = 0
        optionButton.Text = optionName
        optionButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        optionButton.Font = Enum.Font.SourceSans
        optionButton.TextSize = 11
        optionButton.TextXAlignment = Enum.TextXAlignment.Left
        
        -- 当前选中的选项高亮
        if optionName == UISettings.Transparency then
            optionButton.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
            optionButton.BackgroundTransparency = 0.2
        end
        
        optionButton.MouseButton1Click:Connect(function()
            UISettings.Transparency = optionName
            ApplyUISettings()
            SaveSettings(UISettings)
            
            -- 更新所有选项的高亮状态
            for _, child in ipairs(TransparencyOptionsFrame:GetChildren()) do
                if child:IsA("TextButton") then
                    if child.Text == UISettings.Transparency then
                        child.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
                        child.BackgroundTransparency = 0.2
                    else
                        child.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
                        child.BackgroundTransparency = 0.3
                    end
                end
            end
        end)
        
        optionButton.Parent = TransparencyOptionsFrame
        yPosition = yPosition + 20
    end
end

