-- 切换信息显示
local function ToggleInfo()
    IsInfoVisible = not IsInfoVisible
    InfoFrame.Visible = IsInfoVisible
    
    if IsInfoVisible then
        -- 显示动画
        InfoFrame.Size = UDim2.new(0, 0, 0, 0)
        InfoFrame.Visible = true
        local tween = TweenService:Create(InfoFrame, TweenInfo.new(0.3), {
            Size = UDim2.new(0, 280, 0, 350)
        })
        tween:Play()
        
        -- 定位到主UI右侧
        local mainPos = MainContainer.AbsolutePosition
        local mainSize = MainContainer.AbsoluteSize
        InfoFrame.Position = UDim2.new(0, mainPos.X + mainSize.X + 10, 0, mainPos.Y)
    else
        -- 隐藏动画
        local tween = TweenService:Create(InfoFrame, TweenInfo.new(0.2), {
            Size = UDim2.new(0, 0, 0, 0)
        })
        tween:Play()
        tween.Completed:Connect(function()
            InfoFrame.Visible = false
        end)
    end
end

-- 展开/折叠UI
local function ToggleUI()
    IsExpanded = not IsExpanded
    
    if IsExpanded then
        ToggleButton.Text = "⬆"
        local contentHeight = math.min(#Scripts * 35 + (#Scripts) * 8 + 10, 250)
        
        -- 展开动画
        local tween = TweenService:Create(MainContainer, TweenInfo.new(0.3), {
            Size = UDim2.new(0, 220, 0, contentHeight + 35)
        })
        tween:Play()
        
        tween.Completed:Connect(function()
            ContentFrame.Size = UDim2.new(1, 0, 0, contentHeight)
            ScrollFrame.Visible = true
            
            -- 显示所有按钮
            for _, child in ipairs(ScrollFrame:GetChildren()) do
                if child:IsA("TextButton") then
                    child.Visible = true
                end
            end
        end)
    else
        ToggleButton.Text = "⬇"
        ScrollFrame.Visible = false
        
        -- 折叠动画
        local tween = TweenService:Create(MainContainer, TweenInfo.new(0.3), {
            Size = UDim2.new(0, 100, 0, 40)
        })
        tween:Play()
        
        tween.Completed:Connect(function()
            ContentFrame.Size = UDim2.new(1, 0, 0, 0)
        end)
    end
end

