local function LoadSettings()
    local success, savedSettings = pcall(function()
        if readfile then
            return HttpService:JSONDecode(readfile("MR_Settings.json"))
        end
    end)
    
    if success and savedSettings then
        return savedSettings
    end
    
    -- 默认设置
    return {
        Theme = "default",
        Transparency = "中等",
        TransparencyOptions = {
            ["低透明度"] = 0.1,
            ["中等"] = 0.3,
            ["高透明度"] = 0.5,
            ["极高"] = 0.7
